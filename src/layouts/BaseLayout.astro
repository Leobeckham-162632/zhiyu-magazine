---
import '../styles/global.css';
import { site } from '../data/site';
import { url, absolute } from '../utils/urls';
interface Props { title?: string; description?: string; type?: 'website' | 'article'; noindex?: boolean; date?: string; }
const { title, description = site.description, type = 'website', noindex = false, date } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.english}`;
const currentPath = Astro.url.pathname;
const canonical = new URL(currentPath.replace(/\/404\/?$/, '/404.html'), Astro.site).href;
const nav = [['本期目录', 'issues/'], ['全部作品', 'articles/'], ['文学栏目', 'categories/'], ['作者', 'authors/'], ['关于纸屿', 'about/']];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><meta name="theme-color" content="#213f35" />
    {noindex && <meta name="robots" content="noindex, follow" />}<title>{fullTitle}</title>
    <link rel="canonical" href={canonical} /><link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href={url('rss.xml')} />
    <meta property="og:locale" content="zh_CN" /><meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} /><meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute('images/social.png')} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    {date && <meta property="article:published_time" content={`${date}T00:00:00+08:00`} />}<meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳至正文</a>
    <header class="site-header shell">
      <a class="brand" href={url()} aria-label={`${site.name}首页`}><span class="brand-mark" aria-hidden="true">屿</span><span class="brand-name">{site.name}</span><span class="brand-en">ZHIYU<br />LITERARY MAGAZINE</span></a>
      <nav aria-label="主导航">{nav.map(([label, path]) => <a href={url(path)} aria-current={currentPath.startsWith(url(path)) ? 'page' : undefined}>{label}</a>)}<a class="search-nav" href={url('search/')} aria-label="搜索作品"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg><span>搜索</span></a></nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <div><a class="footer-brand" href={url()}>{site.name}<span>在文字之间，留一座岛。</span></a><p>独立文学展示与技术实验 · 2026 年秋季试刊</p><p>示例作品与虚构笔名均已标注。非正式登记期刊，无正式刊号。</p></div>
      <div class="footer-links"><a href={url('issues/')}>翻阅本期</a><a href={url('about/')}>关于纸屿</a><a href={url('colophon/')}>站点说明</a><a href={url('rss.xml')}>RSS 订阅</a><a href="https://github.com/Leobeckham-162632/zhiyu-magazine">GitHub 源码 ↗</a></div>
      <div class="footer-end"><span>© 2026 {site.english}</span><span>慢一点，也没关系。</span><a href="#main">回到页首 ↑</a></div>
    </footer>
  </body>
</html>
