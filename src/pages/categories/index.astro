---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticles } from '../../utils/articles';
import { categories } from '../../data/site';
import { url } from '../../utils/urls';
const articles = await getArticles();
---
<BaseLayout title="文学栏目"><div class="shell"><header class="page-heading"><p class="eyebrow">FIVE WAYS TO READ</p><h1>循着文字，走向不同的岸。</h1><p>小说、散文、诗歌、随笔与文学评论。选择此刻想读的一种。</p></header><div class="author-list page-content">{categories.map((category) => <section class="author-box"><p class="eyebrow">{category.english}</p><h2><a href={url(`categories/${category.id}/`)}>{category.name}</a></h2><p>{category.description}</p><a class="text-link" href={url(`categories/${category.id}/`)}>查看 {articles.filter((article) => article.data.category === category.id).length} 篇作品 ↗</a></section>)}</div></div></BaseLayout>
