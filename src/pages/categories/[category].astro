---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles } from '../../utils/articles';
import { categories } from '../../data/site';
import { url } from '../../utils/urls';
export function getStaticPaths() { return categories.map((category) => ({ params: { category: category.id }, props: { category } })); }
const { category } = Astro.props;
const articles = (await getArticles()).filter((article) => article.data.category === category.id);
---
<BaseLayout title={`${category.name} ${category.english}`} description={category.description}><div class="shell"><header class="page-heading"><p class="eyebrow">{category.english} · {articles.length} 篇作品</p><h1>{category.name}</h1><p>{category.description}</p></header><nav class="filter-nav" aria-label="作品栏目"><a href={url('articles/')}>全部作品</a>{categories.map((item) => <a href={url(`categories/${item.id}/`)} aria-current={item.id === category.id ? 'page' : undefined}>{item.name}</a>)}</nav><div class="page-content">{articles.length ? <div class="article-grid">{articles.map((article) => <ArticleCard article={article} />)}</div> : <p class="empty-state">这个栏目还在等待第一篇作品。<br /><a class="text-link" href={url('articles/')}>先去其他文字里走走 ↗</a></p>}</div></div></BaseLayout>
