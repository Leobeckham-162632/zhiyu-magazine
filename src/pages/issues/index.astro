---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticles } from '../../utils/articles';
import { issues, site } from '../../data/site';
import { url } from '../../utils/urls';
const articles = await getArticles();
---
<BaseLayout title="本期与往期目录"><div class="shell"><header class="page-heading"><p class="eyebrow">THE ISSUES</p><h1>把一段时光，装订成册。</h1><p>每一期，都是一次新的靠岸。</p></header><div class="page-content">{[...issues].reverse().map((issue) => <section class="issue-intro"><a class="issue-number" href={url(`issues/${issue.id}/`)} aria-label={`翻阅第 ${issue.number} 期`}>{issue.number}</a><div><p class="eyebrow">{issue.title} · {issue.month}{issue.id === site.currentIssue && ' · 本期'}</p><h2><a href={url(`issues/${issue.id}/`)}>{issue.theme}</a></h2><p>{issue.subtitle}。共 {articles.filter((article) => article.data.issue === issue.id).length} 篇作品。</p><a class="text-link" href={url(`issues/${issue.id}/`)}>查看完整目录 ↗</a></div></section>)}</div></div></BaseLayout>
