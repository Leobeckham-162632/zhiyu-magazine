---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/site';
import { url } from '../utils/urls';
---
<BaseLayout title="搜索作品" noindex description="按标题、作者、简介或正文搜索纸屿作品。"><div class="shell"><header class="page-heading"><p class="eyebrow">A WORD CAN BE A BEGINNING</p><h1>从一个词，找到一篇文字。</h1><p>搜索标题、作者、简介与正文。留空可浏览全部作品。</p></header><section class="page-content" id="search-app" data-index={url('search-index.json')}><form class="search-form" id="search-form" role="search"><div class="search-field"><label for="query">想找什么？</label><input id="query" name="q" type="search" placeholder="试试“窗”“渡船”或作者笔名" maxlength="100" autocomplete="off" /></div><div class="search-category"><label for="category">栏目</label><select id="category" name="category"><option value="">全部栏目</option>{categories.map((category) => <option value={category.id}>{category.name}</option>)}</select></div><button class="button" type="submit">搜索 <span aria-hidden="true">↗</span></button><button class="clear-button" type="reset">清空</button></form><p class="search-status" id="search-status" role="status" aria-live="polite">正在准备作品索引……</p><div id="search-results" aria-label="搜索结果"></div><noscript><p class="search-help">站内搜索需要 JavaScript。你仍然可以<a class="text-link" href={url('articles/')}>浏览全部作品 ↗</a>，或使用浏览器的页面查找功能。</p></noscript></section></div></BaseLayout>
<script>
  interface SearchEntry { title: string; author: string; summary: string; category: string; categoryName: string; date: string; url: string; body: string; }
  const form = document.getElementById('search-form') as HTMLFormElement;
  const query = document.getElementById('query') as HTMLInputElement;
  const category = document.getElementById('category') as HTMLSelectElement;
  const results = document.getElementById('search-results')!;
  const status = document.getElementById('search-status')!;
  const params = new URLSearchParams(location.search);
  query.value = (params.get('q') ?? '').slice(0, 100);
  category.value = params.get('category') ?? '';
  let entries: SearchEntry[] = [];
  let loaded = false;
  const normalize = (text: string) => text.normalize('NFKC').toLocaleLowerCase().trim();
  const draw = () => {
    if (!loaded) return;
    const terms = normalize(query.value).split(/\s+/).filter(Boolean);
    const matches = entries.filter((entry) => (!category.value || entry.category === category.value) && terms.every((term) => normalize(`${entry.title} ${entry.author} ${entry.summary} ${entry.body}`).includes(term)));
    results.replaceChildren();
    for (const entry of matches) {
      const article = document.createElement('article'); article.className = 'search-result';
      const meta = document.createElement('p'); meta.className = 'result-meta'; meta.textContent = `${entry.categoryName} / ${entry.author} / ${entry.date}`;
      const heading = document.createElement('h2'); const link = document.createElement('a'); link.href = entry.url; link.textContent = entry.title; heading.append(link);
      const summary = document.createElement('p'); summary.textContent = entry.summary;
      article.append(meta, heading, summary); results.append(article);
    }
    status.textContent = matches.length ? `找到 ${matches.length} 篇作品${query.value.trim() ? `，关键词：“${query.value.trim()}”` : ''}。` : '没有找到相应作品。换一个词，或清空栏目条件试试。';
    const address = new URL(location.href);
    if (query.value.trim()) address.searchParams.set('q', query.value.trim()); else address.searchParams.delete('q');
    if (category.value) address.searchParams.set('category', category.value); else address.searchParams.delete('category');
    history.replaceState(null, '', address);
  };
  form.addEventListener('submit', (event) => { event.preventDefault(); draw(); });
  let timer: ReturnType<typeof setTimeout>;
  query.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(draw, 120); });
  category.addEventListener('change', draw);
  form.addEventListener('reset', () => { clearTimeout(timer); query.value = ''; category.value = ''; queueMicrotask(draw); });
  try {
    const response = await fetch(document.getElementById('search-app')!.dataset.index!);
    if (!response.ok) throw new Error('索引暂不可用');
    entries = await response.json(); loaded = true; draw();
  } catch { status.textContent = '作品索引暂时未能加载，请刷新重试，或从“全部作品”浏览。'; }
</script>
