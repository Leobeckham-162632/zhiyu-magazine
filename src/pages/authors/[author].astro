---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles } from '../../utils/articles';
export async function getStaticPaths() { const articles = await getArticles(); return [...new Map(articles.map((article) => [article.data.authorSlug, article.data])).values()].map((author) => ({ params: { author: author.authorSlug }, props: { author } })); }
const { author } = Astro.props;
const articles = (await getArticles()).filter((article) => article.data.authorSlug === author.authorSlug);
const isDemoAuthor = articles.every((article) => article.data.demo);
---
<BaseLayout title={`作者 · ${author.author}`} description={author.authorBio}><div class="shell"><header class="page-heading"><p class="eyebrow">{isDemoAuthor ? '示例作者 · 虚构笔名' : '作者'}</p><h1>{author.author}</h1><p>{author.authorBio}</p>{isDemoAuthor && <p class="demo-notice">此简介为演示设定。试刊示例作品由 AI 为本站创作。</p>}</header><section class="page-content"><div class="section-heading"><h2>在纸屿发表的作品</h2><span class="quiet">{articles.length} 篇</span></div><div class="article-grid">{articles.map((article) => <ArticleCard article={article} />)}</div></section></div></BaseLayout>
