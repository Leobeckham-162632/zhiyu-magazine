---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticles } from '../../utils/articles';
import { url } from '../../utils/urls';
const articles = await getArticles();
const authors = [...new Map(articles.map((article) => [article.data.authorSlug, article.data])).values()];
const isDemoAuthor = (slug: string) => articles.filter((article) => article.data.authorSlug === slug).every((article) => article.data.demo);
---
<BaseLayout title="作者"><div class="shell"><header class="page-heading"><p class="eyebrow">VOICES ON THE ISLAND</p><h1>文字背后，有一个名字。</h1><p>每位作者的作品在此汇集。试刊虚构笔名与示例资料均单独标注。</p></header><div class="author-list page-content">{authors.map((author) => <article class="author-box"><p class="author-label">{isDemoAuthor(author.authorSlug) ? '示例作者 · 虚构笔名' : '作者'}</p><h2><a href={url(`authors/${author.authorSlug}/`)}>{author.author}</a></h2><p>{author.authorBio}</p><a class="text-link" href={url(`authors/${author.authorSlug}/`)}>阅读 {articles.filter((article) => article.data.authorSlug === author.authorSlug).length} 篇作品 ↗</a></article>)}</div></div></BaseLayout>
